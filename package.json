{
  "name": "admin-auth-system",
  "version": "1.0.0",
  "description": "基于 Cloudflare Workers 的安全后台管理系统",
  "main": "workers/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --config wrangler.toml --env staging",
    "deploy:production": "wrangler deploy --config wrangler.toml --env production",
    "db:migrate": "wrangler d1 execute DB --file=./migrations/001_create_users_table.sql",
    "db:seed": "wrangler d1 execute DB --file=./migrations/001_create_users_table.sql",
    "test": "vitest",
    "build": "wrangler deploy --dry-run",
    "init": "wrangler d1 create admin-users"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "authentication",
    "admin",
    "security",
    "backend"
  ],
  "author": "宝通环保设备公司",
  "license": "MIT",
  "dependencies": {
    "hono": "^3.12.0"
  },
  "devDependencies": {
    "vitest": "^1.0.0",
    "wrangler": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}